title: Start
---
<<declare $npcName = "">>
<<declare $signatureName = "">>
<<declare $artistsRealName = "">>
<<declare $impersonatedArtistsName = "">>
<<declare $isFake = false>>
<<declare $isGoodFake = false>>
<<declare $thinksItsFake = false>>
<<declare $willStormOut = false>>
<<declare $actualValue = 0>>
<<declare $askingPrice = 0>>
<<declare $willAcceptPrice = 0>>
<<declare $dice = 0>>

<<lookat npc-camera-target>>
{$npcName}: Hi, I'd  like to sell this painting, it's been in the family for ages, but it's just taking up space now.
{$npcName}: I was told it was <wave a=0.1 f=1>quite valuable</wave>, so I'd need at least ${$askingPrice}.
    <<lookat painting>>


-> Sure, sounds good.
    <<jump Purchased>>
    <<lookat npc-camera-target>>
-> Let me take a closer look
    <<viewpainting>>
-> I don't know...
    <<lookat npc-camera-target>>
    <<if $thinksItsFake>>
        <<jump Haggle>>
    <<elseif $isGoodFake or !$isFake>>
        {$npcName}: My daddy always loved this painting, I'm going to have to insist on ${$askingPrice}
        <<lookat painting>>
        
        -> Sure, sounds good.
            <<jump Purchased>>
        -> Let me take a closer look
            <<viewpainting>>
        -> I'll have to pass.
            <<if dice(4) == 4>>
                <<jump Haggle>>
            <<else>>
                <<jump Leaves>>
            <<endif>>
        <<else>>
            <<jump StormOut>>            
    <<endif>>
===






title: Haggle
---

<<set $askingPrice = ($askingPrice - random_range(1, $askingPrice * 0.1))>>
{$npcName}: Ok, ok, maybe I could come down to... ${$askingPrice}, how does that sound?
<<lookat painting>>

<<set $dice = dice(3)>>
<<if $dice == 1>>
    <<jump Options1>>
<<elseif $dice == 2>>
    <<jump Options2>>
<<elseif $dice == 3>>
    <<jump Options3>>
<<endif>>
===









title: Options1
---

-> Sure, sounds good.
    <<jump Purchased>>
-> Let me take another look
    <<viewpainting>>
-> I'd barely be able to make a profit on it for that, c'mon!
    <<if $willStormOut or random_range(1,3) == 2>>
        <<jump StormOut>>
    <<else>>
        <<jump Haggle>>
    <<endif>>
===


title: Options2
---

-> Sure, sounds good.
    <<jump Purchased>>
-> Let me take another look
    <<viewpainting>>
-> I'm not sure it's really worth that...
    <<if $willStormOut or random_range(1,3) == 2>>
        <<jump StormOut>>
    <<else>>
        <<jump Haggle>>
    <<endif>>
===


title: Options3
---

-> We have a deal.
    <<jump Purchased>>
-> Let me take another look
    <<viewpainting>>
-> ${$askingPrice} for that is a bit much
    <<if $willStormOut or random_range(1,3) == 2>>
        <<jump StormOut>>
    <<else>>
        <<jump Haggle>>
    <<endif>>
===







title: Purchased
---
<<lookat painting>>

<<if $askingPrice > $willAcceptPrice>>
    {$npcName}: Hope you enjoy it as much as daddy did!
<<else>>
    {$npcName}: Yeah ok, well, thanks...
<<endif>>
<<purchase>>
===










title: StormOut
---
<<lookat npc-camera-target>>

{$npcName}: Screw this!
<<storm_out>>
===



title: Leaves
---
<<lookat npc-camera-target>>

{$npcName}: Screw this!
<<storm_out>>
===