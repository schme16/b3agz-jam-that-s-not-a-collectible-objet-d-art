title: Start
---
<<declare $npcName = "">>
<<declare $signatureName = "">>
<<declare $artistsRealName = "">>
<<declare $impersonatedArtistsName = "">>
<<declare $isFake = false>>
<<declare $isGoodFake = false>>
<<declare $thinksItsFake = false>>
<<declare $willStormOut = false>>
<<declare $actualValue = 0>>
<<declare $askingPrice = 0>>
<<declare $willAcceptPrice = 0>>
<<declare $dice = 0>>

===














title: Dialogue1
---

<<lookat npc-camera-target>>
{$npcName}: G'day I was told I could pawn this for cash.
{$npcName}: My mate reckons it's <wave a=0.1 f=1>pretty rare</wave>, I'll sell it to ya for ${$askingPrice}.
    <<lookat painting>>


-> Sure, sounds good.
    <<jump Purchased>>
    <<lookat npc-camera-target>>
-> Let me take a closer look
    <<viewpainting>>
-> Mate, this is trash, shouldn't you pay ME to take it?
    <<lookat npc-camera-target>>
    <<if $thinksItsFake>>
        <<jump Haggle>>
    <<elseif $isGoodFake or !$isFake>>
        {$npcName}: Yeah nah, it's deffo worth ${$askingPrice}
        <<lookat painting>>
        
        -> Sure, sounds good.
            <<jump Purchased>>
        -> Let me take a closer look
            <<viewpainting>>
        -> Yeah pass.
            <<if dice(2) == 2 || ($isFake && dice(2) == 2) || ($thinksItsFake && dice(2) == 2)>>
                <<jump Haggle>>
            <<else>>
                <<jump Leaves>>
            <<endif>>
        <<else>>
            <<jump StormOut>>            
    <<endif>>
===












title: Dialogue2
---

<<lookat npc-camera-target>>
{$npcName}: Hi, I'd  like to sell this painting, it's been in the family for ages, but it's just taking up space now.
{$npcName}: My Daddy told me it was <wave a=0.1 f=1>quite valuable</wave>, so I'd need at least ${$askingPrice}.
    <<lookat painting>>


-> Yeah that seems fair.
    <<jump Purchased>>
    <<lookat npc-camera-target>>
-> Let me take a closer look
    <<viewpainting>>
-> Look, we're not a charity
    <<lookat npc-camera-target>>
    <<if $thinksItsFake>>
        <<jump Haggle>>
    <<elseif $isGoodFake or !$isFake>>
        {$npcName}: My daddy loved this painting, I'm really going to have to insist on ${$askingPrice}
        <<lookat painting>>
        
        -> Sure, sounds good.
            <<jump Purchased>>
        -> Let me take a closer look
            <<viewpainting>>
        -> Yeah... I'm gonna have to pass.
            <<if dice(4) == 3>>
                <<jump Haggle>>
            <<else>>
                <<jump Leaves>>
            <<endif>>
        <<else>>
            <<jump StormOut>>            
    <<endif>>
===










title: Dialogue3
---

<<lookat npc-camera-target>>
{$npcName}: Hello!
{$npcName}: ....
{$npcName}: Umm...
{$npcName}: Did you want this? I'd be happy to part with it for only ${$askingPrice}.
    <<lookat painting>>


-> Sure, sounds good.
    <<jump Purchased>>
    <<lookat npc-camera-target>>
-> Let me take a closer look
    <<viewpainting>>
-> Not sure we're interested hey
    <<lookat npc-camera-target>>
    <<if $thinksItsFake>>
        <<jump Haggle>>
    <<elseif $isGoodFake or !$isFake>>
        {$npcName}: Really, it's <wave a=0.1 f=1>only</wave> ${$askingPrice}
        <<lookat painting>>
        
        -> Sure, sounds good.
            <<jump Purchased>>
        -> Let me take a closer look
            <<viewpainting>>
        -> Not today, not for  ${$askingPrice}.
            <<if dice(2) == 2 || ($isFake && dice(2) == 2) || ($thinksItsFake && dice(2) == 2)>>
                <<jump Haggle>>
            <<else>>
                <<jump Leaves>>
            <<endif>>
        <<else>>
            <<jump StormOut>>            
    <<endif>>
===










title: Dialogue4
---

<<lookat npc-camera-target>>
{$npcName}: I've come into possession of this rather lovely, and <wave a=0.1 f=1>DEFINITLY REAL</wave> artwork, it could be yours for just ${$askingPrice}.
    <<lookat painting>>


-> Sure, sounds good.
    <<jump Purchased>>
    <<lookat npc-camera-target>>
-> Let me take a closer look
    <<viewpainting>>
-> Not sure we want dodgy goods hey
    <<lookat npc-camera-target>>
    <<if $thinksItsFake>>
        <<jump Haggle>>
    <<elseif $isGoodFake or !$isFake>>
        {$npcName}: Possession is 9/10ths the law- I mean, this is extremely legitimate, and definitely worth ${$askingPrice}
        <<lookat painting>>
        
        -> Sure, sounds good.
            <<jump Purchased>>
        -> Let me take a closer look
            <<viewpainting>>
        -> Yeah nah, I don't want any trouble with the cops
            <<if dice(2) == 2 || ($isFake && dice(2) == 2) || ($thinksItsFake && dice(2) == 2)>>
                <<jump Haggle>>
            <<else>>
                <<jump Leaves>>
            <<endif>>
        <<else>>
            <<jump StormOut>>            
    <<endif>>
===










