===






























title: Haggle
---

<<set $askingPrice = ($askingPrice - random_range(1, $askingPrice * 0.25))>>


<<set $dice = dice(5)>>
<<if $dice == 1>>
    {$npcName}: Ok, ok, maybe I could come down to... ${$askingPrice}, how does that sound?
<<elseif $dice == 2>>
    {$npcName}: Well how about ${$askingPrice}?
<<elseif $dice == 3>>
    {$npcName}: I could come down to ${$askingPrice}?
<<elseif $dice == 4>>
    {$npcName}: Would ${$askingPrice} work?
<<elseif $dice == 5>>
    {$npcName}: Mate I can't go lower than ${$askingPrice}!
<<endif>>


<<lookat painting>>

<<set $dice = dice(5)>>
<<if $dice == 1>>
    <<jump Options1>>
<<elseif $dice == 2>>
    <<jump Options2>>
<<elseif $dice == 3>>
    <<jump Options3>>
<<elseif $dice == 4>>
    <<jump Options4>>
<<elseif $dice == 5>>
    <<jump Options5>>
<<endif>>
===









title: Options1
---

-> Sure, sounds good.
    <<jump Purchased>>
-> Let me take another look
    <<viewpainting>>
-> I'd barely be able to make a profit on it for that, c'mon!
    <<if ($willStormOut && dice(2) == 2) or (random_range(1,5) == 2)>>
        <<jump StormOut>>
    <<else>>
        <<jump Haggle>>
    <<endif>>
===


